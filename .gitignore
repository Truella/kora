# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# supabase
supabase/.temp/
supabase/.branches/_current_branch.txt
# Deno writes a lockfile per function dir on first `deno check`/deploy. Local
# only — the Edge Functions import from jsr:/npm: ranges, so a committed lock
# would pin every future deploy to whatever resolved today.
supabase/functions/**/deno.lock

# editor
.vscode/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
