
# Supabase (safe for the browser — public + anon key only)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Flutterwave public key (safe for the browser, test mode)
NEXT_PUBLIC_FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxx

# --- Edge Function secrets (Supabase dashboard / `supabase secrets set`, NEVER here) ---
# FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxx
# FLW_WEBHOOK_HASH=<your chosen webhook hash>
# SITE_URL=https://<your-app-url>
